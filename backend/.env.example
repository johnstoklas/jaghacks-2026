# --- Gemini API route: POST /api/upload-and-summarize ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Vertex route: POST /api/upload-and-summarize-vertex ---
# Team defaults (hackathon GCP): hacktx-swiftui + instagram-scroller-project + us-south1
# Run: gcloud auth application-default login
#      gcloud config set project hacktx-swiftui
# Override below only if you use a different project/bucket.
# GCP_PROJECT_ID=hacktx-swiftui
# GCS_BUCKET=instagram-scroller-project
# GCP_LOCATION=us-south1
# VERTEX_MODEL=gemini-2.0-flash-001
# DELETE_GCS_AFTER=true
# COMPRESS_WIDTH=540
# COMPRESS_HEIGHT=960
# COMPRESS_FPS=5

# MAX_UPLOAD_MB=100

# --- Database (runs + saved reels; single app, no auth) ---
# SQLite (default):
# DATABASE_URL=sqlite:///./jaghacks.db
# PostgreSQL (e.g. Neon): use postgresql+psycopg:// so SQLAlchemy uses the installed driver.
# Paste your connection string from Neon and change the scheme from postgresql:// to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
